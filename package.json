{
  "name": "plaonner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:logic": "node --test tests/*.node.test.js",
    "deploy": "npm run build && netlify deploy --prod --no-build --dir=dist",
    "deploy:preview": "npm run build && netlify deploy --no-build --dir=dist",
    "test:e2e": "playwright test",
    "test:all": "npm run test:logic && npm test && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "netlify-cli": "24.10.0",
    "@playwright/test": "1.56.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
